# 이 파일만 Git에 포함합니다. 실제 .env.local/.env.demo는 Git 제외입니다.
# 로컬: 이 파일을 .env.local로 복사합니다.
# 시연: .env.demo로 복사 후 아래 세 값을 demo / true / true로 바꿉니다.
# 운영: 파일 없이 Cloudflare Pages Variables에서 production / false / false 설정.
VITE_USE_MOCKS=true
VITE_APP_ENV=development
VITE_DEMO_SWITCH=false

# NAVER Maps v3 Client ID (공개 식별자). Client Secret은 넣지 않습니다.
# 미설정 시 SDK 요청 없이 안내와 수용가 목록을 표시합니다.
VITE_NAVER_MAP_CLIENT_ID=

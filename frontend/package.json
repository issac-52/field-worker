{
  "name": "fieldwork-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "dev:demo": "vite --host 0.0.0.0 --mode demo --port 5176 --strictPort",
    "preview:demo": "vite preview --mode demo --outDir dist-demo --port 4174 --strictPort",
    "preview": "vite preview",
    "postinstall": "msw init public --save",
    "format": "prettier --write src config check-api.ts check-location-map.ts check-scale.ts check-map.ts check-demo.ts check-export.ts index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src config check-api.ts check-location-map.ts check-scale.ts check-map.ts check-demo.ts check-export.ts index.html vite.config.ts tsconfig.json package.json",
    "test:demo": "esbuild check-demo.ts --bundle --platform=node --format=esm --packages=external --outfile=.checks/check-demo.js && node .checks/check-demo.js",
    "test:api": "esbuild check-api.ts check-scale.ts --bundle --platform=node --format=esm --packages=external --outdir=.checks && node .checks/check-api.js && node .checks/check-scale.js",
    "test:map": "esbuild check-map.ts --bundle --platform=node --format=esm --packages=external --outfile=.checks/check-map.js && node .checks/check-map.js",
    "test:export": "esbuild check-export.ts --bundle --platform=node --format=esm --packages=external --outfile=.checks/check-export.js && node .checks/check-export.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "msw": "^2.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "msw": {
    "workerDirectory": "public"
  }
}

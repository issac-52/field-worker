# DB_PASSWORD=provide-through-secret-manager
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=private-fieldwork
# R2_ACCESS_KEY_ID=provide-through-secret-manager
# R2_SECRET_ACCESS_KEY=provide-through-secret-manager


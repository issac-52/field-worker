# Local development only. Spring does not load this file automatically.
SPRING_PROFILES_ACTIVE=local
DB_PASSWORD=fieldwork_dev_only
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176
SESSION_COOKIE_SECURE=false
LOCAL_PHOTO_ROOT=build/private-photos

# Production uses SPRING_PROFILES_ACTIVE=prod and external secret injection.
